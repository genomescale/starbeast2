#!/bin/sh
# Run BEAUti with multiple modules.
# Requires: mvn package -Dmaven.test.skip=true (run once in the beast3 repo)

BEAST3="$HOME/WorkSpace/beast3"
M2="$HOME/.m2/repository"
STARB2="$HOME/WorkSpace/starbeast2"

# add beast-base SNAPSHOT if required
MODULE_PATH="$BEAST3/beast-fx/target/beast-fx-2.8.0-SNAPSHOT.jar"
# MODULE_PATH="$M2/io/github/compevol/beast-fx/2.8.0-beta7/beast-fx-2.8.0-beta7.jar"
MODULE_PATH="$MODULE_PATH:$BEAST3/beast-fx/target/lib"
MODULE_PATH="$MODULE_PATH:$M2/io/github/compevol/sampled-ancestors/2.3.0-beta2/sampled-ancestors-2.3.0-beta2.jar"
MODULE_PATH="$MODULE_PATH:$M2/io/github/compevol/morph-models/1.3.1-beta1/morph-models-1.3.1-beta1.jar"
# MODULE_PATH="$MODULE_PATH:$HOME/WorkSpace/morph-models/target/morph-models-1.3.0-SNAPSHOT.jar"
MODULE_PATH="$MODULE_PATH:$M2/org/apache/commons/commons-math3/3.6.1/commons-math3-3.6.1.jar"
MODULE_PATH="$MODULE_PATH:$M2/com/google/guava/guava/33.3.1-jre/guava-33.3.1-jre.jar"
MODULE_PATH="$MODULE_PATH:$STARB2/target/starbeast2-1.1.0-SNAPSHOT.jar"

java --module-path "$MODULE_PATH" \
     -m beast.fx/beastfx.app.beauti.Beauti "$@"
